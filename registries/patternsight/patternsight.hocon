include "config/llm_config.hocon"

"max_execution_seconds": 600,

"metadata": {
    "description": "PatternSight - an operational memory layer for insurance ops. Given a new incident, it retrieves similar past incidents, suggests a root cause, flags recurring patterns, and recommends a resolution, gated by human review.",
    "tags": ["insurance", "incident-management", "root-cause-analysis", "human-in-the-loop"],
    "sample_queries": [
        "Batch job nightly_claims_load failed with a database connection timeout.",
        "Customer notification emails for policy renewal are not being sent.",
        "Claim processing batch job failed last night. System involved: ClaimEngine, Error Code: DB_CONN_TIMEOUT_504.",
        "Underwriting exception detected in PolicyService: NullPointerException in RiskAssessment Module during premium calculation."
    ]
},

"tools": [

    {
        "name": "ingestion_agent",
        "function": {
            "description": "Entry point for PatternSight. Receives a new incident and normalizes it before analysis."
        },
        "instructions": """
            You are the entry point for PatternSight, an insurance operations incident
            intelligence system.

            TRIAGE THE MESSAGE FIRST:

            CASE A - General chat, greeting, or unrelated message:
            Reply directly yourself, briefly. Do NOT call any tool.

            CASE B - This is a genuine incident description:
            Normalize it in one sentence. Call similarity_retrieval_agent EXACTLY
            ONCE. Do not call it again for any reason. When it responds, output its
            message back to the user EXACTLY as received, character for character.
            Do not summarize, reformat, reword, shorten, or add anything. Do not
            evaluate whether its answer is good enough - simply output it verbatim
            and stop.

            CASE C - This message looks like an approval/correction reply ("approved",
            "yes", "no", a correction):
            FIRST CHECK: does the immediately preceding AI message in this conversation
            actually end with the approval question ("Do you approve this
            recommendation...")? Only if that exact question was truly just asked:
            reply "Recommendation finalized and logged." if approved, or acknowledge
            the correction if not.
            If there is NO pending approval question in the conversation so far (e.g.
            this is the first message, or the last AI message was something else),
            treat this as CASE A instead: reply "I don't have a pending recommendation
            to approve yet - describe an incident first and I'll analyze it."

            Once you choose a case, follow it completely without switching cases or
            reconsidering.
        """,
        "tools": ["similarity_retrieval_agent"]
    },

    {
        "name": "similarity_retrieval_agent",
        "function": {
            "description": "Finds similar past incidents from the historical corpus.",
            "parameters": {
                "type": "object",
                "properties": {
                    "incident_text": {
                        "type": "string",
                        "description": "The normalized incident description to search for."
                    }
                },
                "required": ["incident_text"]
            }
        },
        "instructions": """
            Call incident_matcher EXACTLY ONCE with the incident_text. Do not call it
            again for any reason, even if the results seem weak - proceed with
            whatever it returns.

            Immediately after it responds, call root_cause_suggestion_agent EXACTLY
            ONCE, passing the incident text and the matches with their scores.
            Do not re-call incident_matcher. Do not ask the user anything. Then
            output whatever root_cause_suggestion_agent gives you back, unchanged.
        """,
        "tools": ["incident_matcher", "root_cause_suggestion_agent"]
    },

    {
        "name": "incident_matcher",
        "function": {
            "description": "Searches the synthetic historical incident corpus using TF-IDF similarity and returns the closest matches. Runs fully locally - no external API required.",
            "parameters": {
                "type": "object",
                "properties": {
                    "incident_text": {
                        "type": "string",
                        "description": "The incident description to match against history."
                    },
                    "top_k": {
                        "type": "int",
                        "description": "Maximum number of matches to return."
                    }
                },
                "required": ["incident_text"]
            }
        },
        "class": "incident_matcher.IncidentMatcher",
        "args": { "top_k": 3 }
    },

    {
        "name": "root_cause_suggestion_agent",
        "function": {
            "description": "Proposes the most likely root cause based on matched historical incidents, or flags a knowledge gap if no good match exists.",
            "parameters": {
                "type": "object",
                "properties": {
                    "incident_text": {
                        "type": "string",
                        "description": "The original incident description."
                    },
                    "matches": {
                        "type": "string",
                        "description": "The matches returned by similarity_retrieval_agent, as text."
                    }
                },
                "required": ["incident_text", "matches"]
            }
        },
        "instructions": """
            Look at the best match's similarity_score ONE TIME and decide immediately:

            If below 0.4 or no matches: this is a KNOWLEDGE GAP. Conclusion: "Knowledge
            Gap: No sufficiently similar past incidents found. Recommend creating a
            new knowledge base article after this incident is resolved." Leave
            root_cause_category empty.

            Otherwise: propose the root cause, citing the matched incident_id(s) and
            scores. Extract root_cause_category from the best match.

            Do not deliberate further once you've decided. Immediately call
            recurring_pattern_agent EXACTLY ONCE with the incident, matches, your
            conclusion, and root_cause_category. Then output whatever it gives you
            back, unchanged.
        """,
        "tools": ["recurring_pattern_agent"]
    },

    {
        "name": "recurring_pattern_agent",
        "function": {
            "description": "Counts how often the identified root cause has occurred historically and flags recurring issues.",
            "parameters": {
                "type": "object",
                "properties": {
                    "root_cause_category": {
                        "type": "string",
                        "description": "The root cause category to check, or empty if a knowledge gap was flagged."
                    },
                    "context": {
                        "type": "string",
                        "description": "The incident, matches, and root cause conclusion so far, as text."
                    }
                },
                "required": ["context"]
            }
        },
        "instructions": """
            If root_cause_category is empty (knowledge gap), skip straight to
            calling resolution_recommender_agent with everything unchanged.

            Otherwise, call pattern_counter EXACTLY ONCE with root_cause_category.
            Do not call it again. Quote its returned count and window_days verbatim:
            "This root cause has occurred exactly [count] times in the last
            [window_days] days." If is_recurring is true, add "This is flagged as
            RECURRING."

            Immediately call resolution_recommender_agent EXACTLY ONCE with
            everything gathered plus this statement. Then output whatever it gives
            you back, unchanged.
        """,
        "tools": ["pattern_counter", "resolution_recommender_agent"]
    },

    {
        "name": "pattern_counter",
        "function": {
            "description": "Counts historical occurrences of a given root cause category within a recurrence window. Runs fully locally.",
            "parameters": {
                "type": "object",
                "properties": {
                    "root_cause_category": {
                        "type": "string",
                        "description": "The root cause category to count occurrences of."
                    }
                },
                "required": ["root_cause_category"]
            }
        },
        "class": "pattern_counter.PatternCounter"
    },

    {
        "name": "resolution_recommender_agent",
        "function": {
            "description": "Compiles the resolution, responsible team, and estimated resolution time; recommends a permanent fix if the issue is recurring.",
            "parameters": {
                "type": "object",
                "properties": {
                    "context": {
                        "type": "string",
                        "description": "Everything gathered so far: incident, matches, root cause, recurrence status."
                    }
                },
                "required": ["context"]
            }
        },
        "instructions": """
            If a knowledge gap was flagged, compile only the gap notice and a
            recommendation to create a new KB article.

            Otherwise, from the best match, extract: resolution steps, responsible
            team, estimated resolution time. Include the recurrence statement word
            for word - do not paraphrase it. If flagged RECURRING, add: "This is a
            recurring issue. A permanent fix is recommended rather than a repeat
            workaround."

            Immediately call review_agent EXACTLY ONCE with this compiled package.
            Then output whatever it gives you back, unchanged.
        """,
        "tools": ["review_agent"]
    },

    {
        "name": "review_agent",
        "function": {
            "description": "Presents the full recommendation package to a human reviewer before it is finalized.",
            "parameters": {
                "type": "object",
                "properties": {
                    "package": {
                        "type": "string",
                        "description": "The complete compiled recommendation package."
                    }
                },
                "required": ["package"]
            }
        },
        "instructions": """
            Present the package once, using exactly these headers in order:

            ### Similar Incidents
            ### Root Cause
            ### Recurrence
            ### Recommendation

            Then, as the absolute LAST LINE, ask exactly:
            "Do you approve this recommendation as-is, or would you like to correct
            the root cause, responsible team, or resolution steps before it is
            finalized?"
            Nothing may come after this line. Do this once and stop.
        """
    }
]