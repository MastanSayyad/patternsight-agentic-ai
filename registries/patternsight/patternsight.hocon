include "config/llm_config.hocon"

"metadata": {
    "description": "PatternSight - an operational memory layer for insurance ops. Given a new incident, it retrieves similar past incidents, suggests a root cause, flags recurring patterns, and recommends a resolution, gated by human review.",
    "tags": ["insurance", "incident-management", "root-cause-analysis", "human-in-the-loop"],
    "sample_queries": [
        "Batch job nightly_claims_load failed with a database connection timeout.",
        "Customer notification emails for policy renewal are not being sent."
    ]
},

"tools": [

    {
        "name": "ingestion_agent",
        "function": {
            "description": "Entry point for PatternSight. Receives a new insurance operations incident, batch failure, claim issue, or underwriting exception description and normalizes it before analysis."
        },
        "instructions": """
            You are the entry point for PatternSight, an insurance operations incident
            intelligence system.

            Receive the raw incident description from the user. It may describe a batch
            job failure, a claim processing issue, or an underwriting exception.

            Normalize it:
            - Extract the core issue description in one or two clear sentences.
            - Extract the system or application involved, if mentioned.
            - Extract any error text or codes, if present.

            Call similarity_retrieval_agent with the normalized incident text.
            Return its final result to the user, formatted clearly with headers for:
            Similar Incidents, Root Cause, Recurrence, and Recommendation.
        """,
        "tools": ["similarity_retrieval_agent"]
    },

    {
        "name": "similarity_retrieval_agent",
        "function": {
            "description": "Finds similar past incidents from the historical corpus.",
            "parameters": {
                "type": "object",
                "properties": {
                    "incident_text": {
                        "type": "string",
                        "description": "The normalized incident description to search for."
                    }
                },
                "required": ["incident_text"]
            }
        },
        "instructions": """
            Call the incident_matcher tool with the incident_text you were given.

            It returns the top matches, each with a similarity_score between 0.0 and 1.0.

            Call root_cause_suggestion_agent, passing along the original incident text
            and the full list of matches with their scores.
        """,
        "tools": ["incident_matcher", "root_cause_suggestion_agent"]
    },

    {
        "name": "incident_matcher",
        "function": {
            "description": "Searches the synthetic historical incident corpus using TF-IDF similarity and returns the closest matches. Runs fully locally - no external API required.",
            "parameters": {
                "type": "object",
                "properties": {
                    "incident_text": {
                        "type": "string",
                        "description": "The incident description to match against history."
                    },
                    "top_k": {
                        "type": "int",
                        "description": "Maximum number of matches to return."
                    }
                },
                "required": ["incident_text"]
            }
        },
        "class": "incident_matcher.IncidentMatcher",
        "args": { "top_k": 3 }
    },

    {
        "name": "root_cause_suggestion_agent",
        "function": {
            "description": "Proposes the most likely root cause based on matched historical incidents, or flags a knowledge gap if no good match exists.",
            "parameters": {
                "type": "object",
                "properties": {
                    "incident_text": {
                        "type": "string",
                        "description": "The original incident description."
                    },
                    "matches": {
                        "type": "string",
                        "description": "The matches returned by similarity_retrieval_agent, as text."
                    }
                },
                "required": ["incident_text", "matches"]
            }
        },
        "instructions": """
            Review the matched past incidents and their similarity scores.

            DECISION RULE - Knowledge Gap Branch:
            If the best match has a similarity_score below 0.4, OR no matches were
            returned at all, do NOT propose a root cause. Instead, set your conclusion to:
            "Knowledge Gap: No sufficiently similar past incidents found. Recommend
            creating a new knowledge base article after this incident is resolved."

            OTHERWISE:
            Propose the most probable root cause, explicitly citing which past
            incident_id(s) it is based on and their similarity scores.

            Extract the root_cause_category string from the best-matched incident if
            one exists (you will need it for the next step).

            Call recurring_pattern_agent, passing along the incident text, the matches,
            your root cause conclusion (or knowledge gap notice), and the
            root_cause_category if one was found.
        """,
        "tools": ["recurring_pattern_agent"]
    },

    {
        "name": "recurring_pattern_agent",
        "function": {
            "description": "Counts how often the identified root cause has occurred historically and flags recurring issues.",
            "parameters": {
                "type": "object",
                "properties": {
                    "root_cause_category": {
                        "type": "string",
                        "description": "The root cause category to check, or empty if a knowledge gap was flagged."
                    },
                    "context": {
                        "type": "string",
                        "description": "The incident, matches, and root cause conclusion so far, as text."
                    }
                },
                "required": ["context"]
            }
        },
        "instructions": """
            If a knowledge gap was flagged upstream (no root_cause_category available),
            skip pattern counting entirely and pass everything through unchanged to
            resolution_recommender_agent.

            Otherwise, call the pattern_counter tool with the root_cause_category.

            DECISION RULE:
            If the tool reports is_recurring as true, note this clearly:
            "This root cause has occurred [count] times in the last [window_days] days -
            flagged as RECURRING."

            Call resolution_recommender_agent, passing along everything gathered so far
            plus the recurrence result.
        """,
        "tools": ["pattern_counter", "resolution_recommender_agent"]
    },

    {
        "name": "pattern_counter",
        "function": {
            "description": "Counts historical occurrences of a given root cause category within a recurrence window. Runs fully locally.",
            "parameters": {
                "type": "object",
                "properties": {
                    "root_cause_category": {
                        "type": "string",
                        "description": "The root cause category to count occurrences of."
                    }
                },
                "required": ["root_cause_category"]
            }
        },
        "class": "pattern_counter.PatternCounter"
    },

    {
        "name": "resolution_recommender_agent",
        "function": {
            "description": "Compiles the resolution, responsible team, and estimated resolution time; recommends a permanent fix if the issue is recurring.",
            "parameters": {
                "type": "object",
                "properties": {
                    "context": {
                        "type": "string",
                        "description": "Everything gathered so far: incident, matches, root cause, recurrence status."
                    }
                },
                "required": ["context"]
            }
        },
        "instructions": """
            If a knowledge gap was flagged, compile a package containing only the
            knowledge gap notice and the recommendation to create a new KB article.

            Otherwise, from the best-matched historical incident, extract:
            - Resolution steps previously taken
            - Responsible support group
            - Estimated resolution time

            If the recurrence result flagged this as RECURRING, add:
            "This is a recurring issue. A permanent fix is recommended rather than a
            repeat workaround."

            Call review_agent with the complete compiled package.
        """,
        "tools": ["review_agent"]
    },

    {
        "name": "review_agent",
        "function": {
            "description": "Presents the full recommendation package to a human reviewer before it is finalized.",
            "parameters": {
                "type": "object",
                "properties": {
                    "package": {
                        "type": "string",
                        "description": "The complete compiled recommendation package."
                    }
                },
                "required": ["package"]
            }
        },
        "instructions": """
            Present the complete package clearly to the user, who is acting as the
            human reviewer:
            - Matched past incidents and similarity scores (or knowledge gap notice)
            - Proposed root cause
            - Recurrence status
            - Recommended resolution, responsible team, and estimated resolution time
            - Permanent-fix recommendation, if recurring

            End by asking the human reviewer to confirm or correct this recommendation
            before it is treated as final.
        """
    }
]